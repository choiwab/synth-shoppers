# Dev defaults (committed). `npm run dev` plays the recorded fixture stream with
# NO backend — this is milestone M1 (dashboard demoable on its own).
# To run against H4's real engine instead, set VITE_MOCK=0 (e.g. in .env.local)
# and point the bases at the FastAPI server.
VITE_MOCK=1
VITE_API_BASE=http://localhost:8000
VITE_WS_BASE=ws://localhost:8000
