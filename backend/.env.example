# Synthetic Shoppers — backend environment
# Copy to .env (never commit .env):  cp .env.example .env

# ── Required for REAL mode (H3 browser-use agents) ────────────────────────────
# Used by browser-use's ChatOpenAI to drive the autonomous shopper agents.
# (Mock mode and the test suite do NOT need this.)
OPENAI_API_KEY=sk-...

# ── Optional: storefront base URL (REAL mode) ─────────────────────────────────
# Base URL the agents navigate to. Real-mode agents enter at {LISTING_BASE_URL}/,
# search "beanie", then browse freely; metrics stay scoped to matin_kim_beanie_sg.
# Defaults to H2's Vite dev server on :5174 — override here if it runs elsewhere.
# LISTING_BASE_URL=http://localhost:5174
#
# Set to 1 to use the fully-autonomous browser-use LLM agents (needs OPENAI_API_KEY);
# unset/0 uses the deterministic guided Playwright journey (default, demo-safe).
# BROWSER_USE_AUTONOMOUS=0

# ── Optional / planned (not consumed yet) ─────────────────────────────────────
# Reserved for Claude (claude-sonnet-4-6) listing-copy rewriting per the PRD.
# llm.py is currently a passthrough stub, so this is unused today.
# ANTHROPIC_API_KEY=sk-ant-...
